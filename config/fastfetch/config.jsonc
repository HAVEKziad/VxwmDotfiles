{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
	"display": {
		"key": {
			"width": 15
		},
		"color": {
			"keys": "white",
			"title": "white"
		},
		"size": {
			"binaryPrefix": "jedec"
		},
		"separator": ""
	},
	"logo": {
		"type": "kitty-direct",
		"source": "~/.config/fastfetch/logo.png",
		"width": 30,
		"height": 15
	},
	"modules": [
		"title",
		{
			"type": "os",
			"key": "󰣨 OS",
			"keyColor": "white",
			"format": "{2}"
		},
		{
			"type": "kernel",
			"key": "├ Kernel",
			"keyColor": "white "
		},
		{
			"type": "packages",
			"key": "├󰏖 Packages",
			"keyColor": "white "
		},
		{
			"type": "shell",
			"key": "└ Shell",
			"keyColor": "white "
		},
		{
			"type": "wm",
			"key": " DE/WM",
			"keyColor": "white"
		},
		{
			"type": "lm",
			"key": "├󰧨 LM",
			"keyColor": "white"
		},
		{
			"type": "terminal",
			"key": "├ Term",
			"keyColor": "white"
		},
		{
			"type": "host",
			"key": "󰌢 PC",
			"keyColor": "white"
		},
		{
			"type": "cpu",
			"key": "├󰻠 CPU",
			"keyColor": "white"
		},
		{
			"type": "gpu",
			"key": "├ 󰍛 GPU",
			"keyColor": "white"
		},
		{
			"type": "disk",
			"key": "├ Disk",
			"keyColor": "white"
		},
		{
			"type": "memory",
			"key": "├󰑭 RAM",
			"keyColor": "white"
		},
		{
			"type": "display",
			"key": "├󰍹 Display",
			"keyColor": "white"
		},
		{
			"type": "uptime",
			"key": "└󰅐 UpTime",
			"keyColor": "white"
		}
	]
}
